// use prisma-8

model Vessel {
  id                  Int      @id @default(autoincrement())

  // Regulatory & Identification
  imo                 String   @unique // 7-digit permanent hull ID (e.g. "9811000")
  mmsi                String   @unique // 9-digit AIS transceiver ID
  name                String
  callSign            String?
  flagState           String   // ISO 3166-1 alpha-2 code (e.g., "PA", "MH", "GR")

  // Classification & Engineering (for Maintenance & Spare Parts)
  vesselType          String   // "CONTAINER" | "BULK_CARRIER" | "TANKER" | "GENERAL_CARGO"
  classSociety        String?  // e.g., "DNV", "ABS", "LR", "NK"
  yearBuilt           Int
  builder             String?  // Shipyard name
  mainEngineModel     String?  // Crucial for spare parts matching (e.g., "MAN B&W 11G95ME-C9")

  // Dimensions & Capacity (for Port Routing & Berthing Checks)
  dwt                 Int      // Deadweight tonnage (metric tons)
  grossTonnage        Int      // Gross tonnage (GT)
  teuCapacity         Int?     // Twenty-foot Equivalent Units (null for non-container ships)
  lengthOverall       Float    // LOA in meters
  beam                Float    // Width in meters
  maxDraught          Float    // Maximum depth below waterline in meters

  // Live Telemetry & Voyage Status
  health              Int      @default(100) //0-100%
  operationalStatus   String   @default("AT_SEA") // "AT_SEA" | "IN_PORT" | "ANCHORED" | "DRYDOCK"
  latitude            Float?
  longitude           Float?
  speedKnots          Float?   // Speed Over Ground (SOG)
  heading             Float?   // Course in degrees (0-359)
  destinationPortCode String?  // UN/LOCODE (e.g., "GRPIR", "SGSIN", "NLRTM")
  repairDestination   Json?    // Operator-selected repair port after the related external RFQs were sent
  eta                 DateTime?

  // Timestamps
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @onUpdate(now())

  @@index([vesselType])
  @@index([operationalStatus])
  @@index([destinationPortCode])
}

model Supplier {
  id           Int                @id @default(autoincrement())
  name         String
  email        String             @unique
  portLocation String?
  parts        Json               // [{ partNumber, partName, category }]
  orders       Order[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @onCreate(now()) @onUpdate(now())
}

model Order {
  id         Int       @id @default(autoincrement())
  vesselId   Int
  vessel     Vessel    @relation(fields: [vesselId], references: [id])
  supplierId Int
  supplier   Supplier  @relation(fields: [supplierId], references: [id])

  subject    String
  body       String
  items      Json                                   // [{ partNumber, partName, quantity, notes }]
  urgency    String    @default("NORMAL")           // "LOW" | "NORMAL" | "CRITICAL"
  status     String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, SENT, REJECTED or REPAIR_COMPLETED
  repairFaultId    String? // Shared by supplier drafts from one fault report
  repairHealthLoss Int?    // Actual loss recoverable after all parts for this fault are repaired
  repairPort       Json?   // Shared selection for this fault's RFQs, independent of the current vessel destination

  approvedAt DateTime?
  sentAt     DateTime?
  externalSentAt DateTime? // Only set when the operator confirms an external RFQ send
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @onCreate(now()) @onUpdate(now())

  @@index([repairFaultId])
}

model ReaderIntake {
  id         String   @id
  vesselId   Int?
  vessel     Vessel?  @relation(fields: [vesselId], references: [id])
  sender     String?
  subject    String?
  filename   String?
  category   String
  extraction Json
  createdAt  DateTime @default(now())
}
